<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20151101/dmn.xsd"
             id="loanRateDecisionDef"
             name="Loan Rate Decision"
             namespace="http://camunda.org/schema/1.0/dmn">

  <decision id="loanRateDecision" name="Loan Rate Decision">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="input_1" label="Credit Score">
        <inputExpression id="inputExpression_1" typeRef="integer">
          <text>creditScore</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Rate Tier" name="rateTier" typeRef="string"/>
      <output id="output_2" label="Interest Rate" name="interestRate" typeRef="double"/>
      <rule id="rule_1">
        <inputEntry id="inputEntry_1"><text>&gt;= 750</text></inputEntry>
        <outputEntry id="outputEntry_1"><text>"Prime"</text></outputEntry>
        <outputEntry id="outputEntry_2"><text>4.5</text></outputEntry>
      </rule>
      <rule id="rule_2">
        <inputEntry id="inputEntry_2"><text>[600..749]</text></inputEntry>
        <outputEntry id="outputEntry_3"><text>"Standard"</text></outputEntry>
        <outputEntry id="outputEntry_4"><text>7.9</text></outputEntry>
      </rule>
      <rule id="rule_3">
        <inputEntry id="inputEntry_3"><text>&lt; 600</text></inputEntry>
        <outputEntry id="outputEntry_5"><text>"Sub-prime"</text></outputEntry>
        <outputEntry id="outputEntry_6"><text>12.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

</definitions>